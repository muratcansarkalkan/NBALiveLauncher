<Window x:Class="NBALiveScoreboardEditor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NBA Live Overlay Theme Editor" Width="1380" Height="860"
        MinWidth="1050" MinHeight="680" Background="#171A20" Foreground="#F3F4F6">
    <Window.Resources>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Foreground" Value="#F3F4F6"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#222630" Padding="10,8">
            <StackPanel Orientation="Horizontal">
                <Button Content="Open" Click="OpenTheme_Click" Padding="14,5" Margin="0,0,8,0"/>
                <Button Content="Save" Click="Save_Click" Padding="14,5" Margin="0,0,8,0"/>
                <Button Content="Save As..." Click="SaveAs_Click" Padding="14,5" Margin="0,0,8,0"/>
                <Button Content="Save + Reload in Game" Click="SaveReload_Click" Padding="14,5" Margin="0,0,18,0"/>
                <TextBlock Text="Screen" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="ScreenCombo" Width="105" SelectedIndex="0" Margin="0,0,8,0"
                          SelectionChanged="ScreenCombo_SelectionChanged">
                    <ComboBoxItem Content="Scoreboard" IsEnabled="True"/>
                    <ComboBoxItem Content="Stats" IsEnabled="True"/>
                    <ComboBoxItem Content="Intro" IsEnabled="False"/>
                    <ComboBoxItem Content="Violation" IsEnabled="True"/>
                    <ComboBoxItem Content="Playcall" IsEnabled="False"/>
                </ComboBox>
                <TextBlock Text="Subtype" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="SubtypeCombo" Width="90" SelectedIndex="0" Margin="0,0,18,0">
                    <ComboBoxItem Content="Default"/>
                </ComboBox>
                <TextBlock Text="Away" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="AwayTeamCombo" Width="190" SelectionChanged="PreviewChanged" DisplayMemberPath="DisplayName" Margin="0,0,12,0"/>
                <TextBlock Text="Home" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="HomeTeamCombo" Width="190" SelectionChanged="PreviewChanged" DisplayMemberPath="DisplayName" Margin="0,0,18,0"/>
                <TextBlock Text="Preview" VerticalAlignment="Center" Margin="0,0,5,0"/>
                <ComboBox x:Name="PreviewAspectCombo" Width="88" SelectionChanged="PreviewChanged"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="390"/></Grid.ColumnDefinitions>
            <Grid Grid.Column="0" Margin="14">
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="150"/></Grid.RowDefinitions>
                <Border Background="#0D0F13" BorderBrush="#343946" BorderThickness="1" Padding="12">
                    <Viewbox Stretch="Uniform">
                        <Canvas x:Name="PreviewStage" Width="1366" Height="768" Background="#090B10">
                            <Image x:Name="PreviewBackground" Width="1366" Height="768"
                                   Source="Assets/broadcast-court.png" Stretch="UniformToFill"
                                   Panel.ZIndex="-100000"/>
                            <Canvas x:Name="ReferenceOverlayHost" Width="1366" Height="768"
                                    IsHitTestVisible="False" Panel.ZIndex="-99999"/>
                            <Canvas x:Name="PreviewCanvas" Width="620" Height="68" Background="#E80F1218"
                                    MouseLeftButtonDown="PreviewCanvas_MouseLeftButtonDown"
                                    MouseMove="Canvas_MouseMove" MouseLeftButtonUp="Canvas_MouseLeftButtonUp"/>
                        </Canvas>
                    </Viewbox>
                </Border>
                <GroupBox Grid.Row="1" Header="Preview Data" Margin="0,12,0,0" Padding="8">
                    <WrapPanel>
                        <TextBlock Text="Away score" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="AwayScoreBox" Text="96" Width="48" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Home score" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="HomeScoreBox" Text="98" Width="48" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Clock" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="ClockBox" Text="1:42" Width="58" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Shot" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="ShotBox" Text="9" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Quarter" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="QuarterBox" Text="4" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Away fouls" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="AwayFoulsBox" Text="3" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Home fouls" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="HomeFoulsBox" Text="5" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Away TO" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="AwayTimeoutsBox" Text="2" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Home TO" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="HomeTimeoutsBox" Text="1" Width="42" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Violation" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="ViolationTitleBox" Text="Defensive Foul" Width="120" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Possession" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="ViolationPossessionBox" Text="Minnesota Ball" Width="110" Margin="3" TextChanged="PreviewTextChanged"/>
                        <TextBlock Text="Team RGB" Margin="6" VerticalAlignment="Center"/><TextBox x:Name="ViolationColorBox" Text="18050" Width="72" Margin="3" TextChanged="PreviewTextChanged"/>
                    </WrapPanel>
                </GroupBox>
            </Grid>

            <TabControl Grid.Column="1" Margin="0,14,14,14" Background="#222630">
                <TabItem Header="Layout">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.Foreground="#F3F4F6">
                        <TextBlock Text="Reference width"/><TextBox x:Name="ReferenceWidthBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Reference height"/><TextBox x:Name="ReferenceHeightBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Scale mode"/><ComboBox x:Name="LayoutScaleModeCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Scoreboard X offset"/><TextBox x:Name="ScoreboardOffsetXBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Scoreboard Y offset"/><TextBox x:Name="ScoreboardOffsetYBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Scoreboard width"/><TextBox x:Name="ScoreboardWidthBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Scoreboard height"/><TextBox x:Name="ScoreboardHeightBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Overlay Z-order"/><TextBox x:Name="OverlayZBox" Margin="0,3,0,8"/>
                        <Button Content="Apply Layout" Click="ApplyLayout_Click" Margin="0,8,0,0" Padding="8"/>
                        <Separator Margin="0,14,0,10"/>
                        <TextBlock Text="Additional preview overlays" FontWeight="Bold"/>
                        <ComboBox x:Name="PreviewOverlayCombo" Margin="0,4,0,6"/>
                        <UniformGrid Columns="3">
                            <Button Content="Add..." Click="AddPreviewOverlay_Click" Margin="0,0,3,0" Padding="5"/>
                            <Button Content="Remove" Click="RemovePreviewOverlay_Click" Margin="3,0" Padding="5"/>
                            <Button Content="Clear" Click="ClearPreviewOverlays_Click" Margin="3,0,0,0" Padding="5"/>
                        </UniformGrid>
                        <Separator Margin="0,14,0,10"/>
                        <TextBlock Text="Editor reference background" FontWeight="Bold"/>
                        <DockPanel Margin="0,4,0,6">
                            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowsePreviewBackground_Click" Margin="6,0,0,0" Padding="8,2"/>
                            <TextBox x:Name="PreviewBackgroundPathBox" ToolTip="Leave empty to use the built-in basketball image"/>
                        </DockPanel>
                        <TextBlock Text="Reference image fit"/>
                        <ComboBox x:Name="PreviewBackgroundFitCombo" Margin="0,3,0,6"
                                  SelectionChanged="PreviewBackgroundFit_Changed"/>
                        <UniformGrid Columns="2">
                            <Button Content="Apply Background" Click="ApplyPreviewBackground_Click" Margin="0,0,3,0" Padding="8"/>
                            <Button Content="Use Built-in" Click="ResetPreviewBackground_Click" Margin="3,0,0,0" Padding="8"/>
                        </UniformGrid>
                        <TextBlock Margin="0,14,0,0" Foreground="#AAB2C0" TextWrapping="Wrap"
                                   Text="Drag an uncovered part of the scoreboard background to reposition the entire scoreboard."/>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Element">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.Foreground="#F3F4F6">
                        <TextBlock Text="Selected element" FontWeight="Bold"/>
                        <ComboBox x:Name="ElementSelector" Margin="0,4,0,5"
                                  SelectionChanged="ElementSelector_SelectionChanged"/>
                        <TextBlock x:Name="SelectedElementLabel" Text="Select or click an element" Margin="0,0,0,12" Foreground="#AAB2C0"/>
                        <TextBlock Text="Type"/><ComboBox x:Name="ElementTypeCombo"/>
                        <TextBlock Text="Data binding"/><TextBox x:Name="ElementBindingBox"/>
                        <TextBlock Text="Static text"/><TextBox x:Name="ElementTextBox"/>
                        <TextBlock Text="Font preset (blank = default)"/><ComboBox x:Name="ElementFontCombo" IsEditable="True"/>
                        <TextBlock Text="Image path"/><TextBox x:Name="ElementImageBox"/>
                        <TextBlock Text="Image fit"/><ComboBox x:Name="ElementImageFitCombo"/>
                        <CheckBox x:Name="ElementTintEnabledCheck" Content="Tint image" Margin="0,8,0,0"/>
                        <TextBlock Text="Image tint binding"/><TextBox x:Name="ElementTintBindingBox"/>
                        <TextBlock Text="Image tint color (decimal RGB)"/><TextBox x:Name="ElementTintColorBox"/>
                        <TextBlock Text="Opacity (0-255)"/><TextBox x:Name="ElementOpacityBox"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="X"/><TextBox x:Name="ElementXBox"/>
                            <TextBlock Text="Y"/><TextBox x:Name="ElementYBox"/>
                            <TextBlock Text="Width"/><TextBox x:Name="ElementWidthBox"/>
                            <TextBlock Text="Height"/><TextBox x:Name="ElementHeightBox"/>
                        </UniformGrid>
                        <TextBlock Text="Z-order" Margin="0,8,0,0"/><TextBox x:Name="ElementZBox"/>
                        <CheckBox x:Name="ElementVisibleCheck" Content="Visible" Margin="0,8,0,0"/>
                        <CheckBox x:Name="ElementLockedCheck" Content="Locked in editor"/>
                        <TextBlock Text="Text alignment" Margin="0,8,0,0"/><ComboBox x:Name="ElementAlignmentCombo"/>
                        <TextBlock Text="Text overflow" Margin="0,8,0,0"/><ComboBox x:Name="ElementOverflowCombo"/>
                        <TextBlock Text="Text transform" Margin="0,8,0,0"/><ComboBox x:Name="ElementTextTransformCombo"/>
                        <TextBlock Text="Small caps scale (0.1-1.0)"/><TextBox x:Name="ElementSmallCapsScaleBox"/>
                        <TextBlock Text="Font height (0 = theme default)" Margin="0,8,0,0"/><TextBox x:Name="ElementFontHeightBox"/>
                        <TextBlock Text="Text color (decimal RGB)"/><TextBox x:Name="ElementTextColorBox"/>
                        <TextBlock Text="Fill type" Margin="0,8,0,0"/><ComboBox x:Name="ElementFillTypeCombo"/>
                        <TextBlock Text="Solid color binding"/><TextBox x:Name="ElementFillBindingBox"/>
                        <TextBlock Text="Solid color (decimal RGB)"/><TextBox x:Name="ElementFillColorBox"/>
                        <TextBlock Text="Gradient start binding"/><TextBox x:Name="GradientStartBindingBox"/>
                        <TextBlock Text="Gradient start color"/><TextBox x:Name="GradientStartColorBox"/>
                        <TextBlock Text="Gradient end binding"/><TextBox x:Name="GradientEndBindingBox"/>
                        <TextBlock Text="Gradient end color"/><TextBox x:Name="GradientEndColorBox"/>
                        <TextBlock Text="Gradient direction"/><ComboBox x:Name="GradientDirectionCombo"/>
                        <Button Content="Apply Element Bounds" Click="ApplyElement_Click" Margin="0,12,0,0" Padding="8"/>
                        <TextBlock Text="Drag elements directly on the preview canvas. Use these fields for exact sizing." TextWrapping="Wrap" Foreground="#AAB2C0" Margin="0,14,0,0"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Layers">
                    <DockPanel Margin="12" TextElement.Foreground="#F3F4F6">
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                            <UniformGrid Columns="2">
                                <Button Content="Move Up" Click="LayerUp_Click" Margin="2"/>
                                <Button Content="Move Down" Click="LayerDown_Click" Margin="2"/>
                                <Button Content="Duplicate" Click="DuplicateLayer_Click" Margin="2"/>
                                <Button Content="Delete" Click="DeleteLayer_Click" Margin="2"/>
                            </UniformGrid>
                            <TextBlock Text="Add layer" Margin="0,8,0,2"/>
                            <UniformGrid Columns="3">
                                <Button Content="Rectangle" Click="AddRectangleLayer_Click" Margin="2"/>
                                <Button Content="Image" Click="AddImageLayer_Click" Margin="2"/>
                                <Button Content="Text" Click="AddTextLayer_Click" Margin="2"/>
                            </UniformGrid>
                        </StackPanel>
                        <ListBox x:Name="LayersList" DisplayMemberPath="DisplayName"
                                 SelectionChanged="LayersList_SelectionChanged"/>
                    </DockPanel>
                </TabItem>
                <TabItem Header="Behavior">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.Foreground="#F3F4F6">
                        <TextBlock Text="Scoreboard visibility"/><ComboBox x:Name="VisibilityCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Background color (decimal RGB)"/><TextBox x:Name="BackgroundColorBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Background alpha (0-255)"/><TextBox x:Name="BackgroundAlphaBox" Margin="0,3,0,8"/>
                        <CheckBox x:Name="ShowBackgroundImageCheck" Content="Display scoreboard background image" Margin="0,4"/>
                        <TextBlock Text="Background image (relative to theme folder)"/>
                        <DockPanel Margin="0,3,0,8">
                            <Button DockPanel.Dock="Right" Content="Browse..." Click="BrowseBackgroundImage_Click" Margin="6,0,0,0" Padding="8,2"/>
                            <TextBox x:Name="BackgroundImageBox"/>
                        </DockPanel>
                        <TextBlock Text="Background image alpha (0-255)"/><TextBox x:Name="BackgroundImageAlphaBox" Margin="0,3,0,8"/>
                        <CheckBox x:Name="ShowAccentCheck" Content="Display secondary-color accent strips" Margin="0,4"/>
                        <TextBlock Text="Accent-strip height"/><TextBox x:Name="AccentHeightBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Show after score (milliseconds)"/><TextBox x:Name="AfterScoreBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Always show below game seconds"/><TextBox x:Name="LateGameBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Shot-clock visibility"/><ComboBox x:Name="ShotVisibilityCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Shot-clock display threshold"/><TextBox x:Name="ShotThresholdBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Urgent color threshold"/><TextBox x:Name="UrgentThresholdBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Normal color (decimal RGB)"/><TextBox x:Name="NormalShotColorBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Urgent color (decimal RGB)"/><TextBox x:Name="UrgentShotColorBox" Margin="0,3,0,8"/>
                        <CheckBox x:Name="ShowTeamNamesCheck" Content="Display team names" Margin="0,6"/>
                        <CheckBox x:Name="ShowAwayLogoCheck" Content="Display away logo" Margin="0,3"/>
                        <CheckBox x:Name="ShowHomeLogoCheck" Content="Display home logo" Margin="0,3,0,6"/>
                        <TextBlock Text="Team-name format"/><ComboBox x:Name="TeamFormatCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Period format"/><ComboBox x:Name="PeriodFormatCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Foul display"/><ComboBox x:Name="FoulModeCombo" Margin="0,3,0,8"/>
                        <TextBlock Text="Timeout display"/><ComboBox x:Name="TimeoutModeCombo" Margin="0,3,0,8"/>
                        <CheckBox x:Name="ShowBonusCheck" Content="Display BONUS" Margin="0,6"/>
                        <TextBlock Text="Bonus threshold"/><TextBox x:Name="BonusThresholdBox" Margin="0,3,0,8"/>
                        <TextBlock Text="Scale mode"/><ComboBox x:Name="ScaleModeCombo" Margin="0,3,0,8"/>
                        <Separator Margin="0,12,0,10"/>
                        <TextBlock Text="Overlay animation" FontWeight="Bold"/>
                        <TextBlock Text="Enter type"/><ComboBox x:Name="EnterAnimationCombo" Margin="0,3,0,8"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Enter from X"/><TextBox x:Name="EnterFromXBox"/>
                            <TextBlock Text="Enter from Y"/><TextBox x:Name="EnterFromYBox"/>
                            <TextBlock Text="Enter duration ms"/><TextBox x:Name="EnterDurationBox"/>
                            <TextBlock Text="Hold duration ms"/><TextBox x:Name="HoldDurationBox"/>
                        </UniformGrid>
                        <TextBlock Text="Exit type" Margin="0,8,0,0"/><ComboBox x:Name="ExitAnimationCombo" Margin="0,3,0,8"/>
                        <UniformGrid Columns="2">
                            <TextBlock Text="Exit to X"/><TextBox x:Name="ExitToXBox"/>
                            <TextBlock Text="Exit to Y"/><TextBox x:Name="ExitToYBox"/>
                            <TextBlock Text="Exit duration ms"/><TextBox x:Name="ExitDurationBox"/>
                        </UniformGrid>
                        <CheckBox x:Name="FreezeAnimationCheck" Content="Freeze animation while paused" Margin="0,8,0,0"/>
                        <Button Content="Preview Animation" Click="PreviewAnimation_Click" Margin="0,8,0,0" Padding="8"/>
                        <Button Content="Apply Behavior" Click="ApplyBehavior_Click" Margin="0,8,0,0" Padding="8"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
                <TabItem Header="Font">
                    <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="12" TextElement.Foreground="#F3F4F6">
                        <TextBlock Text="Font file"/><TextBox x:Name="FontFileBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Internal font family name"/><TextBox x:Name="FontFaceBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Font weight"/><TextBox x:Name="FontWeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Character spacing"/><TextBox x:Name="FontSpacingBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Score height"/><TextBox x:Name="ScoreHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Clock height"/><TextBox x:Name="ClockHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Shot-clock height"/><TextBox x:Name="ShotHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Team-name height"/><TextBox x:Name="TeamNameHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Period height"/><TextBox x:Name="PeriodHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Foul text/number height"/><TextBox x:Name="FoulHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="Timeout text/number height"/><TextBox x:Name="TimeoutHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <TextBlock Text="BONUS height"/><TextBox x:Name="BonusHeightBox" Margin="0,3,0,8" TextChanged="FontTextChanged"/>
                        <Button Content="Apply Font" Click="ApplyFont_Click" Margin="0,8,0,0" Padding="8"/>
                    </StackPanel></ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>
        <TextBlock Grid.Row="2" x:Name="StatusText" Text="Open popups\TEST\scoreboard\scoreboard.json to begin" Padding="10,4" Background="#222630" Foreground="#B8C0CF"/>
    </Grid>
</Window>
